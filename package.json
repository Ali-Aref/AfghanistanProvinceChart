{
  "name": "afghanistan-province-charts",
  "version": "0.1.0-beta.0",
  "private": true,
  "type": "module",
  "description": "Monorepo for @afghan-charts/react, an accessible React map and choropleth library for Afghanistan's 34 provinces.",
  "license": "MIT",
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --filter @afghan-charts/react build && pnpm --filter @afghan-charts/playground dev",
    "build": "pnpm --filter @afghan-charts/react build && pnpm --filter @afghan-charts/playground build",
    "build:lib": "pnpm --filter @afghan-charts/react build",
    "test": "pnpm -r --if-present test",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "data:geometry": "tsx scripts/generate-geometry.ts",
    "data:validate": "tsx scripts/validate-geography.ts",
    "package:check": "pnpm --filter @afghan-charts/react package:check",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.1",
    "@types/d3-geo": "3.1.1",
    "@types/geojson": "7946.0.16",
    "@types/node": "26.6.6",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-server": "3.0.4",
    "@types/topojson-specification": "1.0.5",
    "d3-geo": "3.1.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "polylabel": "2.1.0",
    "prettier": "3.10.1",
    "publint": "0.3.25",
    "topojson-client": "3.1.0",
    "topojson-server": "3.0.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  }
}
